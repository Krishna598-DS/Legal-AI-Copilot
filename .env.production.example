# Production example — copy values into real secrets store / host env.
# Do not commit real secrets.

ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FILE_NAME=app.log
REQUIRE_EMAIL_VERIFICATION=true
CACHE_SIZE=64
REQUEST_TIMEOUT=60
RETRY_COUNT=2
