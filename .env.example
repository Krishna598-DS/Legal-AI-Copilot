# Copy to .env — never commit secrets.
# Optional overlays: .env.development | .env.testing | .env.production

ENVIRONMENT=development
OPENAI_API_KEY=sk-your-key-here
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
# Aliases also supported: JWT_SECRET, JWT_EXPIRE_MINUTES, CHAT_MODEL

ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=

DATA_DIR=data
UPLOAD_DIR=
INDEX_DIR=
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

CACHE_SIZE=0
MAX_UPLOAD_BYTES=10485760
REQUEST_TIMEOUT=60
RETRY_COUNT=2

LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0
RETRIEVAL_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHAT_MEMORY_WINDOW=6

CORS_ORIGINS=http://localhost:8510,http://127.0.0.1:8510
APP_BASE_URL=http://127.0.0.1:8010
FRONTEND_URL=http://127.0.0.1:8010
FRONTEND_DIR=

ADMIN_EMAILS=
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TIMEOUT=30
SMTP_FROM=noreply@legalrag.local

MAX_QUESTIONS_PER_HOUR=60
MAX_UPLOADS_PER_HOUR=10
MAX_DOCUMENTS_PER_USER=20
ENABLE_UPLOAD_SCAN=true
CLAMAV_HOST=
CLAMAV_TIMEOUT=10
USE_LLM_CLASSIFIER=true

TERMS_VERSION=2026-07-17
PRIVACY_VERSION=2026-07-17

SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
