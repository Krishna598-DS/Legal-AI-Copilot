# Development defaults (non-secrets). Loaded after `.env`.

ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
REQUIRE_EMAIL_VERIFICATION=false
CACHE_SIZE=0
REQUEST_TIMEOUT=60
RETRY_COUNT=2
LLM_TEMPERATURE=0
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHAT_MEMORY_WINDOW=6
